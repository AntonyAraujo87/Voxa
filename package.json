{
  "name": "voxa",
  "private": true,
  "version": "0.6.0",
  "description": "Streaming P2P nativo de vídeo e input para Windows, com baixa latência em Rust e UDP.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "server": "node server/index.js",
    "dev:all": "node scripts/dev.mjs",
    "app": "node scripts/dev-native.mjs",
    "app:build": "tauri build",
    "app:build:local": "node scripts/build-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/test/*.test.js scripts/check-native.test.mjs scripts/check-deployment.test.mjs scripts/promote-release.test.mjs",
    "verify": "tsc --noEmit && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
