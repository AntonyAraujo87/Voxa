# Use variaveis do ambiente da hospedagem; o servidor nao carrega este arquivo.
PORT=3001
ORIGIN=*
# 1 apenas atras de proxy confiavel; o blueprint Render configura 1.
TRUST_PROXY=0
# Limite por sala (1 a 16). Quatro equilibra uso e upload do host.
VOXA_MAX_VIEWERS=4
# Relay UDP externo anunciado pelo matchmaking. Deixe vazio no desenvolvimento.
VOXA_RELAY_PUBLIC_ENDPOINT=
# Mesmo segredo de 32+ caracteres configurado na VM do relay.
VOXA_RELAY_SECRET=
# Use somente ao executar o relay no mesmo processo (normalmente fica 0 no Render).
VOXA_RELAY_PORT=0
