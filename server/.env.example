# Use variaveis do ambiente da hospedagem; o servidor nao carrega este arquivo.
PORT=3001
VOXA_TOKEN=
ORIGIN=*
# 1 apenas atras de proxy confiavel; o blueprint Render configura 1.
TRUST_PROXY=0
# TURN com credenciais temporarias (coturn use-auth-secret).
# O segredo fica exclusivamente no servidor; nao use prefixo VITE_.
VOXA_TURN_URLS=
VOXA_TURN_SECRET=
