{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxa",
  "version": "0.1.0",
  "identifier": "com.voxa.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Voxa",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#1e1f22",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNTA0ODk3QTVDODY2OUUKUldTZVpzaWxsMGhReWtNREM1QXAwSVFXdkVsL2wwUFkrT1hKanNuMDFQdTVIRHRZNkFJZWptcjkK",
      "endpoints": [
        "https://github.com/AntonyAraujo87/voxa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
