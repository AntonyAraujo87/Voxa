# ---------------------------------------------------------------------------
# Signaling (Fase 2). Em dev: npm run server e deixe localhost.
# Em producao: a URL publica do servico (ex.: https://voxa-signaling.onrender.com)
# ---------------------------------------------------------------------------
VITE_SIGNALING_URL=http://localhost:3001

# Senha da sala. Precisa ser IGUAL ao VOXA_TOKEN do servidor.
# Vazio = servidor aberto (so use assim em localhost).
VITE_ROOM_TOKEN=

# ---------------------------------------------------------------------------
# TURN (opcional, mas praticamente obrigatorio fora da LAN)
#
# STUN sozinho falha quando os DOIS lados estao atras de NAT simetrico ou
# CGNAT. TURN e um relay: sempre funciona, mas todo o video passa por ele.
# Varias URLs separadas por virgula.
#
# Opcao gratuita com limite mensal (Open Relay / Metered):
#   VITE_TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443
#   VITE_TURN_USERNAME=openrelayproject
#   VITE_TURN_CREDENTIAL=openrelayproject
# Atencao: o video passa pelos servidores deles. Para algo privado, suba um
# coturn proprio num VPS.
# ---------------------------------------------------------------------------
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# "relay" forca tudo pelo TURN — serve so pra testar se o relay funciona.
VITE_ICE_POLICY=all

# ---------------------------------------------------------------------------
# Supabase (opcional): historico de mensagens e canais.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
