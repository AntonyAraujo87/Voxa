# Variaveis publicas no bundle. A senha da sala e digitada no login.
VITE_SIGNALING_URL=http://localhost:3001

# Preferencial: TURN temporario no servidor (server/.env.example).
# Fallback legado; credenciais ficam visiveis no build.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# relay exige TURN e serve para validar a rota; all permite caminho direto.
VITE_ICE_POLICY=all

# Historico/anexos opcionais. Somente chave publica do cliente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
